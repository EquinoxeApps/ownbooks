  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:rls": "jest --config supabase/tests/jest.config.js",
    "doctor": "expo-doctor",
    "postinstall": "patch-package",
    "build:reader": "node scripts/build-reader.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "license": "MIT",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-audio"
        ]
      },
      "ios": {
        "buildFromSource": [
          "expo-audio"
        ]
      }
    }
