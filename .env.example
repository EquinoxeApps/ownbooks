# Copy to .env and fill in with your own projects. Never commit .env.

# Supabase (Project Settings → API). The publishable/anon key is safe in the
# client only because row-level security is enforced on every table.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google sign-in (Google Cloud console → Credentials → OAuth client IDs).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_IOS_URL_SCHEME=

# Bundle identifier / Android package. Forks must set their own (e.g. com.example.ownbooks);
# left empty, it defaults to the upstream app.equinoxe.ownbooks.
OWNBOOKS_BUNDLE_ID=

# Your own EAS account and project (from `npx eas-cli init`). Defaults to the upstream project.
EAS_OWNER=
EAS_PROJECT_ID=

# Facebook sign-in (Meta for Developers → your app → Settings → Basic / Advanced).
# Both are public values. Leave empty to hide the Facebook button.
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=

# Apple sign-in on Android uses Apple's web sign-in and needs an Apple Services ID set up in
# Supabase (Authentication → Providers → Apple). Set to 1 once that's done.
EXPO_PUBLIC_APPLE_WEB_SIGN_IN=

# Analytics and crash reports (Firebase console → Project settings → Your apps). Put
# google-services.json and GoogleService-Info.plist in the repo root (both gitignored); EAS builds
# read them from the GOOGLE_SERVICES_JSON / GOOGLE_SERVICE_INFO_PLIST file variables instead.
# Without both files the app is built without Firebase and never asks for analytics consent.
